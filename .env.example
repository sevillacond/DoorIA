# ==============================================================================
# ENLACE-DOORIA - CONFIGURAÇÃO DE AMBIENTE (LOCAL-FIRST & PRODUÇÃO)
# ==============================================================================

# AMBIENTE DE EXECUÇÃO
NODE_ENV=development
APP_URL=http://localhost:3000

# ==============================================================================
# SEGREDOS CRÍTICOS (OBRIGATÓRIOS EM PRODUÇÃO - MÍNIMO 32 CARACTERES)
# NUNCA UTILIZAR VALORES PADRÃO OU CONHECIDOS
# ==============================================================================
SESSION_SECRET=

# ==============================================================================
# BANCO DE DADOS PURO LOCAL (POSTGRESQL 16 LTS)
# OBRIGATÓRIO: Definir POSTGRES_PASSWORD forte no servidor físico da guarita
# ==============================================================================
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dooria
POSTGRES_DB=dooria_db
POSTGRES_PASSWORD=
PGHOST=postgres
PGPORT=5432
PGUSER=dooria
PGPASSWORD=
PGDATABASE=dooria_db

# ==============================================================================
# IDENTIDADE DO CONDOMÍNIO (OBRIGATÓRIO EM PRODUÇÃO - SEM DADOS FICTÍCIOS)
# ==============================================================================
CONDO_ID=condo-master
CONDO_NAME=
CONDO_TRADING_NAME=
CONDO_CNPJ=
CONDO_CITY=
CONDO_STATE=
CONDO_UNITS_COUNT=
CONDO_STREET=
CONDO_NUMBER=
CONDO_NEIGHBORHOOD=
CONDO_ZIP=

# ==============================================================================
# INFRAESTRUTURA LOCAL-FIRST DA GUARITA
# OBRIGATÓRIO EM PRODUÇÃO: IP estático fixo do Mini PC na LAN da guarita (ex: 192.168.1.100)
# ==============================================================================
LOCAL_SERVER_IP=
HARDWARE_MODE=simulated

# ==============================================================================
# SUPER ADMINISTRADOR INICIAL (OBRIGATÓRIO EM PRODUÇÃO)
# ==============================================================================
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# ==============================================================================
# TELEFONIA E INTERFONIA (ASTERISK 20 LTS PURE PJSIP / WEBRTC)
# OBRIGATÓRIO EM PRODUÇÃO: IP estático fixo do servidor Asterisk na guarita
# ==============================================================================
ASTERISK_HOST=
ASTERISK_SIP_SERVER=
ASTERISK_SIP_PORT=5060
ASTERISK_WSS_PORT=8089
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=dooria_admin
ASTERISK_AMI_USER=dooria_admin
ASTERISK_AMI_SECRET=

# ==============================================================================
# TOTEM EXTERNO INTELBRAS XPE / CONTROLE DE ACESSO
# ==============================================================================
XPE_IP=
XPE_SIP_USERNAME=8000
XPE_SIP_SECRET=
XPE_RTSP_USERNAME=admin
XPE_RTSP_PASSWORD=
RELAY_CONTROLLER_IP=

# ==============================================================================
# STREAMING DE VÍDEO CFTV (GO2RTC)
# ==============================================================================
GO2RTC_API_URL=http://localhost:1984

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL MAIA (GEMINI SERVER-SIDE)
# ==============================================================================
GEMINI_API_KEY=
