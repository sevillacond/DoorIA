# ==============================================================================
# ENLACE-DOORIA - CONFIGURAÇÃO DE AMBIENTE (LOCAL-FIRST & PRODUÇÃO)
# ==============================================================================

# AMBIENTE DE EXECUÇÃO
NODE_ENV=development
APP_URL=http://localhost:3000

# ==============================================================================
# SEGREDOS CRÍTICOS (OBRIGATÓRIOS EM PRODUÇÃO - MÍNIMO 32 CARACTERES)
# NUNCA UTILIZAR VALORES PADRÃO OU CONHECIDOS
# ==============================================================================
SESSION_SECRET=

# ==============================================================================
# BANCO DE DADOS PURO LOCAL (POSTGRESQL 16 LTS)
# OBRIGATÓRIO: Definir POSTGRES_PASSWORD forte no servidor físico da guarita
# ==============================================================================
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dooria
POSTGRES_DB=dooria_db
POSTGRES_PASSWORD=
PGHOST=postgres
PGPORT=5432
PGUSER=dooria
PGPASSWORD=
PGDATABASE=dooria_db

# ==============================================================================
# IDENTIDADE DO CONDOMÍNIO (OBRIGATÓRIO EM PRODUÇÃO - SEM DADOS FICTÍCIOS)
# ==============================================================================
CONDO_ID=condo-master
CONDO_NAME=
CONDO_TRADING_NAME=
CONDO_CNPJ=
CONDO_CITY=
CONDO_STATE=
CONDO_UNITS_COUNT=
CONDO_STREET=
CONDO_NUMBER=
CONDO_NEIGHBORHOOD=
CONDO_ZIP=

# ==============================================================================
# INFRAESTRUTURA LOCAL-FIRST DA GUARITA
# OBRIGATÓRIO EM PRODUÇÃO: IP estático fixo do Mini PC na LAN da guarita (ex: 192.168.1.100)
# ==============================================================================
LOCAL_SERVER_IP=
HARDWARE_MODE=simulated

# ==============================================================================
# SUPER ADMINISTRADOR INICIAL (OBRIGATÓRIO EM PRODUÇÃO)
# ==============================================================================
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# ==============================================================================
# TELEFONIA E INTERFONIA (ASTERISK 20 LTS PURE PJSIP / WEBRTC)
# OBRIGATÓRIO EM PRODUÇÃO: IP estático fixo do servidor Asterisk na guarita
# ==============================================================================
ASTERISK_HOST=
ASTERISK_SIP_SERVER=
ASTERISK_SIP_PORT=5060
ASTERISK_WSS_PORT=8089
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_USER=
ASTERISK_AMI_SECRET=

# ==============================================================================
# TOTEM EXTERNO INTELBRAS XPE / CONTROLE DE ACESSO
# ==============================================================================
XPE_IP=
XPE_SIP_USERNAME=8000
XPE_SIP_SECRET=
XPE_RTSP_USERNAME=admin
XPE_RTSP_PASSWORD=
RELAY_CONTROLLER_IP=
DEPLOY_TARGET=
TRIGGER_METHOD=

# ==============================================================================
# STREAMING DE VÍDEO CFTV (GO2RTC WEBRTC GATEWAY)
# ==============================================================================
# URL da API REST/WebSocket do go2rtc (acesso determinístico a partir do container dooria-core)
# NOTA DE ARQUITETURA: Como o go2rtc roda em network_mode: host e o dooria-core roda na rede bridge
# dooria-network, NUNCA utilize localhost ou 127.0.0.1 em produção física.
# Utilize o IP da guarita (ex: http://192.168.1.100:1984), o gateway Docker (http://172.28.0.1:1984) ou http://host.docker.internal:1984.
GO2RTC_API_URL=http://172.28.0.1:1984

# Controle Explícito de Habilitação de Câmeras CFTV
# REGRAS DE SEGURANÇA:
# - Câmera habilitada (true) EXIGE URL RTSP válida (formato: rtsp://<user>:<pass>@<ip>:554/<path>).
# - Câmeras desabilitadas (false) NÃO são provisionadas como streams vazias no go2rtc.
# - Rejeição fail-fast de strings vazias (""), "null", "undefined" ou "rtsp://" em câmeras habilitadas.
CAMERA_PORTARIA_ENABLED=true
CAMERA_GARAGEM_ENABLED=false
CAMERA_HALL_ENABLED=false
CAMERA_GOURMET_ENABLED=false

# URLs RTSP das Câmeras
# As credenciais ficam exclusivamente nas variáveis do ambiente local da guarita, nunca no repositório Git.
GO2RTC_CAMERA_PORTARIA_URL=
GO2RTC_CAMERA_GARAGEM_URL=
GO2RTC_CAMERA_HALL_URL=
GO2RTC_CAMERA_GOURMET_URL=

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL MAIA (GEMINI SERVER-SIDE)
# ==============================================================================
GEMINI_API_KEY=
