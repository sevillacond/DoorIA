# ==============================================================================
# ENLACE-DOORIA - CONFIGURAÇÃO DE AMBIENTE (LOCAL-FIRST & PRODUÇÃO)
# ==============================================================================

# GEMINI_API_KEY: Inteligência Artificial Concierge MaIA (Google Gemini 2.5 Flash / 3.8).
# No AI Studio / Cloud Run, esta chave é gerenciada pelo ambiente.
GEMINI_API_KEY=

# APP_URL: URL base pública onde a aplicação está hospedada.
APP_URL=http://localhost:3000

# Chave secreta para assinatura criptográfica de sessões e tokens (HMAC-SHA256)
SESSION_SECRET=

# ==============================================================================
# BANCO DE DADOS PURO LOCAL (POSTGRESQL 16 LTS)
# ==============================================================================
# Conexão nativa local-first na porta 5432 do servidor da guarita (Mini PC)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=dooria
PGPASSWORD=
PGDATABASE=dooria_db

# ==============================================================================
# TELEFONIA E INTERFONIA (ASTERISK 20 LTS PURE)
# ==============================================================================
# Conexão nativa SIP / PJSIP / WebRTC / AMI para interfonia autônoma
ASTERISK_HOST=127.0.0.1
ASTERISK_SIP_PORT=5060
ASTERISK_WSS_PORT=8089
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=dooria_admin
ASTERISK_AMI_SECRET=

# ==============================================================================
# STREAMING DE VÍDEO CFTV (GO2RTC)
# ==============================================================================
# Servidor local de streaming WebRTC sub-50ms para câmeras RTSP
GO2RTC_API_URL=http://localhost:1984
