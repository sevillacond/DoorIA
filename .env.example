# ==============================================================================
# ENLACE-DOORIA - CONFIGURAÇÃO DE AMBIENTE (LOCAL-FIRST & CLOUD RUN)
# ==============================================================================

# GEMINI_API_KEY: Obrigatória para inteligência MaIA (Google Gemini 3.8 Flash).
# No AI Studio / Cloud Run, esta chave é injetada automaticamente em tempo de execução.
GEMINI_API_KEY=

# APP_URL: URL base onde a aplicação está hospedada.
# Injetada automaticamente pelo AI Studio / Cloud Run.
APP_URL=

# ==============================================================================
# BANCO DE DADOS PURO LOCAL (POSTGRESQL 16 LTS)
# ==============================================================================
# Conexão nativa local-first na porta 5432 do servidor da guarita (Mini PC)
DATABASE_URL=postgresql://dooria:dooria_secret@localhost:5432/dooria_db
PGHOST=localhost
PGPORT=5432
PGUSER=dooria
PGPASSWORD=dooria_secret
PGDATABASE=dooria_db

# ==============================================================================
# TELEFONIA E INTERFONIA (ASTERISK 20 LTS PURE)
# ==============================================================================
# Conexão nativa SIP / PJSIP / WebRTC / AMI para interfonia autônoma
ASTERISK_HOST=127.0.0.1
ASTERISK_SIP_PORT=5060
ASTERISK_WSS_PORT=8089
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=dooria_admin
ASTERISK_AMI_SECRET=dooria_ami_secret

# ==============================================================================
# STREAMING DE VÍDEO CFTV (GO2RTC)
# ==============================================================================
# Servidor local de streaming WebRTC sub-50ms para câmeras RTSP
GO2RTC_API_URL=http://localhost:1984

